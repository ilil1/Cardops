MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=cardops
MYSQL_USER=cardops_app
MYSQL_PASSWORD=change-app-password
MYSQL_PORT=3307
APP_ENV=development
# Generate locally, for example: openssl rand -hex 32
JWT_SECRET=
AUTH_COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_RATE_WINDOW_SECONDS=900
# Local development only. Keep false outside a disposable development database.
ALLOW_TEST_USER_SEEDING=false
# Required only when seeding local role-based test accounts. Do not commit real values.
TEST_ADMIN_PASSWORD=
TEST_ANALYST_PASSWORD=
TEST_OPERATIONS_PASSWORD=
TEST_MARKETING_PASSWORD=
FORCE_MODEL_REBUILD=false

# FastAPI runs on the host in local development. If FastAPI also runs in
# Compose, change 127.0.0.1 to mysql in the DATABASE_URL.
DATABASE_URL=mysql+pymysql://cardops_app:change-app-password@127.0.0.1:3307/cardops

# Render deployment with TiDB Cloud.
# Enter the real value in Render Dashboard as the backend DATABASE_URL;
# do not commit a TiDB password to this file.
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:4000/test?ssl_verify_cert=true&ssl_verify_identity=true
